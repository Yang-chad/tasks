#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""全功能并行执行入口 v6.2 — func12-17 + 迭代报告 + 产出效率
用法: python _run_full_parallel.py [--dry-run]
总耗时: max(v6.0, iterations, workload) → 预期 ~25s (v6.2 消除 workload 竞态)
"""
import subprocess, sys, time, os, io

sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8', errors='replace')
PYTHON = r"C:\Users\gree\.workbuddy\binaries\python\envs\default\Scripts\python.exe"
BASE = r"C:\Users\gree\Desktop\AI工作场景\项目管理"
TASKS_REPO = r"C:\Users\gree\tasks"
TODAY = time.strftime("%Y-%m-%d", time.localtime())

MONTH_ARG = TODAY[:7]  # e.g. "2026-06"
SCRIPTS = [
    ("func12-17", f"{BASE}/_run_all_6.py", []),        # v6.0 unified
    ("iter-reports", f"{BASE}/_batch_iteration_report.py", [f"{BASE}/{TODAY}"]),
    ("workload", f"{BASE}/_workload_analysis.py", ["--month", MONTH_ARG]),  # v6.2 消除竞态
]


def run_one(name, script, args):
    """运行单个脚本，返回耗时"""
    t0 = time.time()
    env = os.environ.copy()
    env["PYTHONIOENCODING"] = "utf-8"
    r = subprocess.run(
        [PYTHON, script] + args,
        capture_output=True, text=True, encoding='utf-8', errors='replace',
        timeout=600, env=env,
    )
    elapsed = time.time() - t0
    ok = r.returncode == 0
    marker = "OK" if ok else "FAIL"
    print(f"\n{'='*50}")
    print(f"[{marker}] {name} ({elapsed:.1f}s)")
    # Print last few lines
    lines = (r.stdout or "").strip().split('\n')
    for ln in lines[-8:]:
        print(f"  {ln}")
    if r.stderr:
        for ln in (r.stderr or "").strip().split('\n')[-5:]:
            print(f"  [stderr] {ln}")
    print(f"{'='*50}")
    return ok, elapsed


def _write_dashboard_summary(tasks_out):
    """Generate dashboard_summary.json for live page data sync via raw.githubusercontent.com"""
    import json
    summary_src = os.path.join(BASE, "_run_all_summary.json")
    if not os.path.exists(summary_src):
        return
    with open(summary_src, 'r', encoding='utf-8') as f:
        data = json.load(f)
    result = {
        "product_count": data.get("产品任务", {}).get("total", 0),
        "backend_count": data.get("后端开发", {}).get("total", 0),
        "frontend_count": data.get("前端开发", {}).get("total", 0),
        "mobile_count": data.get("移动端开发", {}).get("total", 0),
        "overdue_count": data.get("产品任务", {}).get("overdue", 0),  # 延期来自产品任务
        "updated": time.strftime("%Y-%m-%d %H:%M", time.localtime()),
        "today": TODAY,
    }
    dst = os.path.join(tasks_out, "dashboard_summary.json")
    with open(dst, 'w', encoding='utf-8') as f:
        json.dump(result, f, ensure_ascii=False)
    print(f"  [OK] dashboard_summary.json → {dst}")


def post_process():
    """收尾: cp to tasks repo + git push"""
    print("\n[Post] Copying to tasks repo...")
    today_out = f"{BASE}/{TODAY}"
    tasks_out = f"{TASKS_REPO}/{TODAY}"
    os.makedirs(tasks_out, exist_ok=True)

    # Copy all HTML (use shutil for speed)
    import shutil
    for fn in os.listdir(today_out):
        if fn.endswith('.html'):
            shutil.copy2(os.path.join(today_out, fn), os.path.join(tasks_out, fn))

    # Generate dashboard_summary.json (供 GitHub Pages 动态拉取，绕过 CDN 延迟)
    _write_dashboard_summary(tasks_out)

    # Copy root index.html to tasks repo (关键：趋势数据更新后同步到 GitHub Pages)
    root_src = os.path.join(BASE, "index.html")
    root_dst = os.path.join(TASKS_REPO, "index.html")
    if os.path.exists(root_src):
        shutil.copy2(root_src, root_dst)

    # Git push (v6.2.1: 检测 push 失败 + pull --rebase 解决远程冲突)
    os.chdir(TASKS_REPO)
    subprocess.run(["git", "add", "."], capture_output=True, check=True)
    r_cmt = subprocess.run(["git", "commit", "-m", f"update: {TODAY} 禅道全功能报告(v6.0统一拉取)"],
                           capture_output=True, text=True)
    # commit 允许无变化（nothing to commit）退出码 1
    if r_cmt.returncode not in (0, 1):
        print(f"[Git] commit FAILED: {r_cmt.stderr.strip()}")
        return

    # 先拉取合并远程变更，避免 push rejected
    r_pull = subprocess.run(["git", "pull", "--rebase", "origin", "main"],
                            capture_output=True, text=True)
    if r_pull.returncode != 0:
        print(f"[Git] pull --rebase FAILED: {r_pull.stderr.strip()}")
        return

    r = subprocess.run(["git", "push", "origin", "main"], capture_output=True, text=True)
    if r.returncode != 0:
        print(f"[Git] push FAILED: {r.stderr.strip()}")
        return
    print(f"[Git] push OK: {r.stdout.strip() or '(clean)'}")
    print("[Post] Done.")


def main():
    dry_run = "--dry-run" in sys.argv
    print(f"🚀 全功能并行执行 — {TODAY}")
    if dry_run:
        print("  (dry-run: 只打印将要执行的命令)")
        return

    t_total = time.time()

    # ── 并行启动三个独立任务 ──
    from concurrent.futures import ThreadPoolExecutor, as_completed
    results = {}
    with ThreadPoolExecutor(max_workers=3) as pool:
        futures = {pool.submit(run_one, name, script, args): name for name, script, args in SCRIPTS}
        for f in as_completed(futures):
            name = futures[f]
            ok, elapsed = f.result()
            results[name] = {"ok": ok, "elapsed": elapsed}

    # ── 收尾: 生成迭代总览(index.html) + cp + git push ──
    t_parallel = time.time() - t_total
    print(f"\n⏱️  并行阶段: {t_parallel:.1f}s (预期 ~22s)")

    if not dry_run:
        # ── 并行: 迭代总览 + 趋势计算（必须先完成，再执行 git push）──
        
        def run_overview():
            print("\n[Overview] Generating iteration overview page...")
            r = subprocess.run(
                [PYTHON, f"{BASE}/_generate_iteration_overview.py", f"{BASE}/{TODAY}"],
                capture_output=True, text=True, encoding='utf-8', errors='replace',
            )
            if r.stdout:
                print(f"  {r.stdout.strip()}")
        
        def run_trend():
            print("\n[Trend] Computing add/remove data...")
            r = subprocess.run(
                [PYTHON, f"{BASE}/_compute_trend_data.py", "--update-index"],
                capture_output=True, text=True, encoding='utf-8', errors='replace',
            )
            for ln in (r.stdout or "").strip().split('\n'):
                print(f"  {ln}")
        
        with ThreadPoolExecutor(max_workers=2) as pool:
            f1 = pool.submit(run_overview)
            f2 = pool.submit(run_trend)
            f1.result(); f2.result()

        # 必须在 overview + trend 完成后再 push，否则 index.html 未更新就被复制到 tasks repo
        post_process()

    total = time.time() - t_total
    print(f"\n🏁 全流程完成: {total:.1f}s (vs 原 ~94s)")
    for name, r in results.items():
        status = "✅" if r["ok"] else "❌"
        print(f"  {status} {name}: {r['elapsed']:.1f}s")


if __name__ == "__main__":
    main()
